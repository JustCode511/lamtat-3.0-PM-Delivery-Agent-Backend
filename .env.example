# ==========================================================
# Copy this file to ".env" and fill in your real values.
# The real .env is gitignored and must NEVER be committed.
# ==========================================================

# Which environment: "local" or "aws"
APP_ENV=local

# Which LLM adapter to use: "gemini" | "openai" | "bedrock"
LLM_PROVIDER=gemini

# --- Auth (JWT) ---
# Secret used to sign/verify JWTs. MUST be a strong random value.
# Locally: set it here. On AWS: store in SSM Parameter Store (SecureString)
# and inject as the JWT_SECRET Lambda env var.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret
# How long an issued token stays valid (hours)
JWT_EXPIRY_HOURS=24

# Comma-separated origins allowed by CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Gemini (local dev, free tier) ---
# Get from https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=your-gemini-key-here

# --- OpenAI / ChatGPT (set LLM_PROVIDER=openai to use) ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Jira ---
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-token-here

# --- Slack ---
# Incoming Webhook URL — used for HITL approval requests
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Bot Token — used for general notifications via chat.postMessage
# Get from: https://api.slack.com/apps -> your app -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Target channel for notifications (replace with your real channel ID)
SLACK_CHANNEL_ID=your-channel-id-here

# --- CloudWatch Observability ---
# Set AWS_REGION to enable. On Lambda the IAM role provides credentials automatically.
# For local dev, ensure aws configure is set up (or set AWS_ACCESS_KEY_ID/SECRET).
# IAM permissions needed: logs:CreateLogGroup, logs:CreateLogStream, logs:PutLogEvents,
#                          cloudwatch:PutMetricData
AWS_REGION=ap-southeast-1
CW_LOG_GROUP=/lamtat/chat
CW_METRICS_NS=LAMTAT/Chat
