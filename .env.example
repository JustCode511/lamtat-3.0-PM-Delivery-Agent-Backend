# ==========================================================
# Copy this file to ".env" and fill in your real values.
# The real .env is gitignored and must NEVER be committed.
# ==========================================================

# Which environment: "local" or "aws"
APP_ENV=local

# Which LLM adapter to use: "gemini" | "openai" | "bedrock"
LLM_PROVIDER=gemini

# --- Gemini (local dev, free tier) ---
# Get from https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=your-gemini-key-here

# --- OpenAI / ChatGPT (set LLM_PROVIDER=openai to use) ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Jira (leave as-is until you set up the account) ---
JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-token-here

# --- Slack ---
# Incoming Webhook URL — used for HITL approval requests
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Bot Token — used for general notifications via chat.postMessage
# Get from: https://api.slack.com/apps -> your app -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Target channel for notifications
SLACK_CHANNEL_ID=C0BJ56AD24V

# --- JWT (for auth, added later) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-later
